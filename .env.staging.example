# Шаблон переменных для ОТДЕЛЬНОЙ тестовой (staging) CMS.
# Реальный файл .env.staging создаётся вручную рядом (в .gitignore,
# в git не попадает). Значения ниже — только имена переменных.

HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Используются docker-compose.staging.yml для подстановки ${...}
# ВАЖНО: docker compose по умолчанию берёт .env для подстановки ${VAR},
# а не .env.staging. Поэтому запускать нужно с явным флагом:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up
STAGING_POSTGRES_USER=tobemodified
STAGING_POSTGRES_PASSWORD=tobemodified
